# =====================================================================
# MailBot — ortam degiskenleri
# Bu dosyayi ".env" adiyla kopyalayip degerleri doldurun.
# .env dosyasi ASLA commit edilmez.
# =====================================================================

# --- Uygulama ---------------------------------------------------------
DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3000"
# Maillerin icine konan adres (takip pikseli, video onizlemesi, cikis linki).
# SADECE SAHIP OLDUGUNUZ bir alan adi yazin, ornegin https://mail.alanadiniz.com
# Gecici tunel adresleri (trycloudflare, ngrok) kabul edilmez: bu alan adlari
# oltalama icin kotuye kullanildigindan mailleriniz dogrudan spam'e duser.
# Bos birakilirsa takip kapanir; mailde piksel ve gorsel olmaz, listeden cikis
# mailto: ile yapilir. Sistem calismaya devam eder, sadece acilma takibi olmaz.
MAIL_TRACKING_URL=""

# Kalici Cloudflare tuneli adi (alan adinizi bagladiktan sonra).
# Bos ise MailBot.bat tunel penceresi acmaz.
CLOUDFLARE_TUNNEL_NAME=""
APP_INTERNAL_API_KEY=""

# --- Groq AI ----------------------------------------------------------
# https://console.groq.com  ->  API Keys  ->  Create API Key
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# --- Gmail API (OAuth2 / Desktop app) ---------------------------------
# Google Cloud Console -> APIs & Services -> Credentials
#   1) Gmail API'yi etkinlestirin
#   2) OAuth consent screen -> External -> kendi mailinizi test user ekleyin
#   3) Credentials -> Create -> OAuth client ID -> Desktop app
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
# Asagidaki token "npm run gmail:auth" komutu ile uretilir (Faz 5).
GMAIL_REFRESH_TOKEN=""
# Gonderim yapilacak Gmail adresi
GMAIL_USER=""
# Mail altbilgisinde gorunecek imza bilgileri (spam skoru icin gerekli)
SENDER_NAME=""
SENDER_TITLE=""
SENDER_ADDRESS=""

# --- n8n --------------------------------------------------------------
N8N_BASE_URL="http://localhost:5678"
# n8n -> Settings -> n8n API -> Create an API key
N8N_API_KEY=""
# Faz 3'te "mailbot-discovery" workflow'u kurulunca olusur.
N8N_WEBHOOK_DISCOVER_URL="http://localhost:5678/webhook/mailbot-discovery"

# --- SearXNG (local Docker) -------------------------------------------
SEARXNG_URL="http://localhost:8080"

# --- Discord bot ------------------------------------------------------
# https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_BOT_TOKEN=""
# Discord'da Gelistirici Modu'nu acip kanala sag tik -> ID'yi Kopyala
DISCORD_CHANNEL_ID=""
# Kendi Discord kullanici ID'niz (sadece bu kullanici komut calistirabilir)
DISCORD_OWNER_ID=""

# --- Video ------------------------------------------------------------
# Maile gomulen thumbnail'in tiklaninca gidecegi videonun barindigi adres.
# Ornek: YouTube "liste disi" linki veya kendi tunel adresiniz.
VIDEO_BASE_URL=""

# --- Gonderim limitleri (spam korumasi) -------------------------------
SEND_DAILY_LIMIT="50"
SEND_HOURLY_LIMIT="20"
SEND_MIN_DELAY_SECONDS="45"
SEND_MAX_DELAY_SECONDS="90"
