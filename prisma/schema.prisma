// MailBot veri modeli — SQLite + Prisma
// Migration Faz 1'de calistirilir: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// Baglanti URL'i prisma.config.ts icinde tanimli (Prisma 7 kurali).
datasource db {
  provider = "sqlite"
}

/// Bulunan veya elle eklenen sirket.
model Company {
  id          Int       @id @default(autoincrement())
  name        String
  website     String?
  domain      String?   @unique
  email       String?
  phone       String?
  city        String?
  sector      String?
  /// "n8n" | "manual" | "csv"
  source      String    @default("manual")
  /// Discovery sirasinda siteden cikarilan ham metin ozeti
  rawSnippet  String?
  /// Groq siniflandirma guven skoru (0-1)
  score       Float?
  isEcommerce Boolean   @default(true)
  /// Bounce/hata alan adresler false yapilir, bir daha mail gonderilmez.
  isActive    Boolean   @default(true)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  discoveryRunId Int?
  discoveryRun   DiscoveryRun? @relation(fields: [discoveryRunId], references: [id])
  messages       Message[]

  @@index([city])
  @@index([sector])
  @@index([isActive])
}

/// Mail sablonu + video bilgisi.
model Campaign {
  id             Int       @id @default(autoincrement())
  name           String
  subject        String
  /// {{company}} gibi degiskenler iceren govde
  bodyTemplate   String
  /// AI ile iyilestirilmeden onceki orijinal taslak
  originalDraft  String?
  videoUrl       String?
  videoThumbPath String?
  spamScore      Float?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  messages Message[]
}

/// Tek bir sirkete gonderilen tek bir mail.
model Message {
  id             Int       @id @default(autoincrement())
  companyId      Int
  campaignId     Int?
  toEmail        String
  subject        String
  bodyHtml       String
  /// QUEUED | SENT | FAILED | BOUNCED
  status         String    @default("QUEUED")
  /// Tracking pixel URL'inde kullanilan uuid
  trackingId     String    @unique
  gmailMessageId String?
  gmailThreadId  String?
  sentAt         DateTime?
  /// Ilk gercek acilma. null ise UI'da kirmizi/tek tik, dolu ise cift yesil tik.
  /// Sahte acilma (mail tarayici, on yukleme) burayi doldurmaz.
  openedAt       DateTime?
  /// Son gercek acilma — "3 kez acildi, en son 14:20" gorunumu icin.
  lastOpenedAt   DateTime?
  openCount      Int       @default(0)
  /// Maildeki takipli linke ilk tiklama. Acilmadan daha guclu bir ilgi sinyali.
  firstClickAt   DateTime?
  clickCount     Int       @default(0)
  /// "Mailiniz acildi" bildirimi Discord'a dusuruldugunde damgalanir.
  openNotifiedAt DateTime?
  error          String?
  createdAt      DateTime  @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  replies  Reply[]
  events   TrackEvent[]

  @@index([status])
  @@index([gmailThreadId])
  @@index([openedAt])
}

/// Tek bir acilma veya tiklama olayi.
///
/// Message.openedAt/openCount ozet alanlardir; burasi ham kayittir. Sahte
/// acilmalar da (isBot = true) yazilir ki filtrenin ne eledigi gorulebilsin.
model TrackEvent {
  id        Int      @id @default(autoincrement())
  messageId Int
  /// OPEN | CLICK
  type      String
  /// CLICK icin tiklanan adres
  target    String?
  at        DateTime @default(now())
  userAgent String?
  ip        String?
  /// Sahte acilma filtresinin karari — true ise sayaclara islenmez.
  isBot     Boolean  @default(false)
  /// isBot ise hangi kurala takildigi
  reason    String?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, type])
  @@index([at])
}

/// Gelen yanit ve AI analizi.
model Reply {
  id                Int       @id @default(autoincrement())
  messageId         Int
  fromEmail         String
  bodyText          String
  gmailMessageId    String?   @unique
  receivedAt        DateTime
  /// POSITIVE | NEUTRAL | NEGATIVE
  sentiment         String    @default("NEUTRAL")
  sentimentScore    Float?
  summary           String?
  /// Discord'a bildirim gonderildiyse dolu (sadece POSITIVE icin)
  discordNotifiedAt DateTime?
  answeredAt        DateTime?
  /// Kullanici listeden kaldirdiysa dolu. Kayit silinmez: gmailMessageId
  /// durdugu icin gelen kutusu senkronizasyonu ayni yaniti tekrar acmaz.
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([sentiment])
  @@index([deletedAt])
}

/// Bir discovery calistirmasi (prompt -> sirket listesi).
model DiscoveryRun {
  id          Int       @id @default(autoincrement())
  prompt      String
  /// RUNNING | DONE | FAILED
  status      String    @default("RUNNING")
  source      String    @default("searxng")
  resultCount Int       @default(0)
  /// "ui" | "discord"
  triggeredBy String    @default("ui")
  error       String?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?

  companies Company[]
}

/// Basit key/value ayarlar (gunluk gonderim sayaci, warm-up asamasi vb.)
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
