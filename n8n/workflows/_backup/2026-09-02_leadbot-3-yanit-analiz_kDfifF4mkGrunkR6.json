            {
              "id": "cond-found",
              "leftValue": "={{ $json.found }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "if-found",
      "name": "Lead Bulundu mu?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1160,
        300
      ]
    },
    {
      "parameters": {},
      "id": "noop-yoksay",
      "name": "Bilinmeyen Gonderen (yoksay)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1380,
        440
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: \"openai/gpt-oss-20b\",\n  temperature: 0,\n  response_format: { type: \"json_object\" },\n  messages: [\n    {\n      role: \"system\",\n      content: \"Sen bir satis asistanisin. Sana bir isletmeden gelen e-posta yaniti verilecek. Yaniti su uc kategoriden birine ata: olumlu (ilgileniyor, gorusmek/bilgi almak istiyor, fiyat soruyor), beklemede (simdi degil, sonra donerim, karar asamasinda, belirsiz, otomatik yanit), olumsuz (ilgilenmiyor, listeden cikmak istiyor, reddediyor). SADECE su JSON semasiyla yanit ver: {\\\"durum\\\": \\\"olumlu|beklemede|olumsuz\\\", \\\"gerekce\\\": \\\"tek cumlelik kisa gerekce\\\"}\"\n    },\n    {\n      role: \"user\",\n      content: \"Konu: \" + $json.konu + \"\\n\\nYanit:\\n\" + $json.metin\n    }\n  ]\n}) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "http-groq",
      "name": "Groq: Siniflandir",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1380,
        180
      ],
      "notes": "CREDENTIAL: Header Auth -> Authorization: Bearer <GROQ_API_KEY>. Model: openai/gpt-oss-20b",
      "notesInFlow": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "hF1zCvop9VcBM1RL",
          "name": "Groq Header Auth (DOLDUR: value)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Groq JSON ciktisini dogrular; beklenmedik bir sey gelirse \"beklemede\"ye duser.\nconst izinli = [\"olumlu\", \"beklemede\", \"olumsuz\"];\nconst yanit = items[0].json;\n\nlet ham = \"\";\ntry {\n  ham = yanit.choices[0].message.content;\n} catch (e) {\n  throw new Error(\"Groq yaniti okunamadi: \" + JSON.stringify(yanit).slice(0, 300));\n}\n\nlet sonuc = {};\ntry {\n  sonuc = JSON.parse(ham);\n} catch (e) {\n  const m = String(ham).match(/\\{[\\s\\S]*\\}/);\n  sonuc = m ? JSON.parse(m[0]) : {};\n}\n\nconst durum = izinli.includes(sonuc.durum) ? sonuc.durum : \"beklemede\";\nconst gerekce = String(sonuc.gerekce || \"AI gerekce dondurmedi\").slice(0, 300);\n\nconst mail = $(\"Yaniti Hazirla\").first().json;\nconst lead = $(\"Lead'i Bul\").first().json.lead;\n\nreturn [{\n  json: {\n    panelBaseUrl: mail.panelBaseUrl,\n    panelKey: mail.panelKey,\n    leadId: lead.id,\n    business_name: lead.business_name || lead.email,\n    email: lead.email,\n    durum,\n    gerekce,\n    metin: mail.metin,\n  },\n}];"
      },
      "id": "code-sonuc",
      "name": "Sonucu Ayikla",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        180
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.panelBaseUrl }}/api/leads/{{ $json.leadId }}/status",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-panel-key",
              "value": "={{ $json.panelKey }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: $json.durum, replyText: $json.gerekce + \" | \" + $json.metin }) }}",
        "options": {}
      },
      "id": "http-status",
      "name": "Panel: Durumu Guncelle",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1820,
        180
      ],
      "notes": "Credential gerekmez; x-panel-key Panel Ayarlari node'undan gelir.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "authentication": "webhook",
        "content": "={{ ({olumlu: \"\\uD83D\\uDFE2\", beklemede: \"\\uD83D\\uDFE1\", olumsuz: \"\\uD83D\\uDD34\"})[$json.durum] }} **{{ $json.durum.toUpperCase() }}** - {{ $json.business_name }} ({{ $json.email }})\\n> {{ $json.gerekce }}\\n\\n*Yanit:* {{ $json.metin.slice(0, 300) }}",
        "options": {}
      },
